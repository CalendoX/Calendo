{
  "name": "calendo-scheduling",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Calendo — interview scheduling platform for hiring teams",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 9000",
    "build": "next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start -p 9000",
    "worker": "node dist/worker.js",
    "deploy": "npm run build && cp -r .next/static .next/standalone/.next/ && node dist/migrate.js && pm2 startOrReload ecosystem.config.cjs --update-env && pm2 save",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:deploy": "node dist/migrate.js",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.47.0",
    "luxon": "^3.7.2",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
