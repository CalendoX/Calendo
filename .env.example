# -----------------------------------------------------------------------------------------------
# Slate — environment configuration
#
# Copy to `.env` for local development:   cp .env.example .env
# In production, set these as real environment variables (secrets manager / orchestrator);
# never commit real values. Every variable is validated at startup (src/server/config/env.ts).
# -----------------------------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Public base URL of the app (no trailing slash). Used in emails, OAuth redirects and CSRF origin
# checks. Must be https:// in production — this also switches on Secure/__Host- session cookies.
APP_URL=http://localhost:3001
# Product name shown in emails.
APP_NAME=Slate

# ---- Database (PostgreSQL; developed and tested on 17. Migrations create the btree_gist extension) -
DATABASE_URL=postgres://slate:slate@localhost:5432/slate
DATABASE_POOL_MAX=10
# Set to true when your provider requires TLS (certificate is verified).
DATABASE_SSL=false
# Integration tests use a separate database whose name must end in _test.
# TEST_DATABASE_URL=postgres://slate:slate@localhost:5432/slate_test

# ---- Secrets -----------------------------------------------------------------------------------
# Keys HMAC session / capability tokens. At least 32 characters.
#   Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
# AES-256-GCM key for OAuth tokens and Zoom host URLs: exactly 32 bytes, base64 encoded.
#   Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
# Optional, for key rotation: comma-separated previous keys that can still decrypt old values.
# ENCRYPTION_KEY_PREVIOUS=

# ---- Google Calendar (OAuth 2.0 web client) ------------------------------------------------
# Leave blank to disable the integration (the UI shows it as "not configured").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# ---- Zoom (OAuth "General app", user-managed) ------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3001/api/integrations/zoom/callback
# Secret Token from the app's "Event Subscriptions" feature; enables /api/webhooks/zoom.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Public https base URL that Google/Zoom can reach for webhooks. Defaults to APP_URL.
# Google push notifications are only registered when this is https (use a tunnel locally).
# WEBHOOK_BASE_URL=https://your-tunnel.example.com

# ---- Email -----------------------------------------------------------------------------------
# smtp | resend | console   (console logs emails to the worker's stdout)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Slate Scheduling <scheduling@example.com>"
# EMAIL_REPLY_TO=
# SMTP (Mailpit from docker-compose.yml in development: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Resend (when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=

# ---- Background jobs -------------------------------------------------------------------------
# Jobs run on pg-boss inside PostgreSQL (no Redis required). Parallel jobs per queue per worker.
WORKER_CONCURRENCY=5

# ---- HTTP / security -------------------------------------------------------------------------
# Comma-separated origins allowed to call the public scheduling API cross-origin (e.g. an
# embedded widget on your careers site). The dashboard API is same-origin only.
# CORS_ALLOWED_ORIGINS=https://careers.example.com
# Trust X-Forwarded-For from your load balancer for rate limiting and audit IPs.
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info
